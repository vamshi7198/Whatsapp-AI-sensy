# =============================================================================
# Uncanned WhatsApp — environment configuration
#
# Copy to .env and fill in real values. NEVER commit .env.
#
# RULE: no variable here may ever be prefixed NEXT_PUBLIC_.
# That prefix ships the value to the browser. Nothing in this file may go there.
# =============================================================================

# --- Core ---------------------------------------------------------------
DATABASE_URL="postgresql://uncanned:uncanned_local_dev@localhost:5432/uncanned_whatsapp"
REDIS_URL="redis://localhost:6379"
APP_URL="http://localhost:3000"

# --- Authentication -----------------------------------------------------
# Generate: openssl rand -base64 32
AUTH_SECRET=""

# --- Secret encryption --------------------------------------------------
# Encrypts the Meta access token stored in the database (AES-256-GCM).
# Generate: openssl rand -base64 32
# Losing this key makes the stored token unrecoverable — back it up securely.
APP_ENCRYPTION_KEY=""

# --- Meta WhatsApp Cloud API -------------------------------------------
# App Secret verifies webhook signatures. Environment only — never the database,
# never the UI, never logged.
META_APP_ID=""
META_APP_SECRET=""

# You generate this, then paste the same value into Meta's webhook config.
# Generate: openssl rand -hex 32
META_WEBHOOK_VERIFY_TOKEN=""

# NOTE: WABA ID, Phone Number ID, API version and the access token are NOT
# environment variables. An ADMIN manages them in Settings, with the token
# encrypted at rest — so rotating credentials needs no redeploy.

# --- Operational defaults (overridable in Settings) ---------------------
DEFAULT_TIMEZONE="Asia/Kolkata"
SEND_RATE_LIMIT_MPS="20"
LARGE_CAMPAIGN_THRESHOLD="500"
WEBHOOK_RETENTION_DAYS="30"

# --- Seed (development only) -------------------------------------------
# Used once by `npm run db:seed` to create the first ADMIN.
# Change this password immediately after first login.
SEED_ADMIN_EMAIL="admin@uncanned.in"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Uncanned Admin"
