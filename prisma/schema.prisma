// Uncanned WhatsApp — database schema
// Design rationale: ../../docs/01-DATABASE-SCHEMA.md
//
// Principles applied throughout:
//  - phoneE164 is the contact identity key; uniqueness enforced by the database
//  - every constraint preventing a duplicate send is a DB constraint, not app logic
//  - all timestamps are timestamptz/UTC; display timezone is a presentation concern
//  - nothing with messaging history is hard-deleted

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  AGENT
}

enum OptInStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum WhatsAppStatus {
  UNKNOWN
  VALID
  INVALID
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  RUNNING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
  CANCELLED
}

enum RecipientStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum AudienceType {
  ALL_CONTACTS
  TAG
  TAGS
  SELECTED
  CSV_UPLOAD
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum OptOutScope {
  MARKETING
  ALL
}

enum AutomationTriggerType {
  KEYWORD
  INCOMING_MESSAGE
  TAG_ADDED
  MANUAL
}

enum AutomationActionType {
  SEND_TEMPLATE
  SEND_TEXT
  ADD_TAG
  REMOVE_TAG
  SET_OPT_OUT
}

enum ImportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(AGENT)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions           Session[]
  campaignsCreated   Campaign[]     @relation("CampaignCreatedBy")
  auditLogs          AuditLog[]
  conversationsOwned Conversation[]
  messagesSent       Message[]      @relation("MessageSentBy")
  automations        Automation[]
  imports            ImportJob[]

  @@index([role])
  @@index([isActive])
}

/// Database-backed sessions rather than stateless JWTs: deleting rows revokes
/// access instantly when someone leaves. A JWT stays valid until it expires.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

// ---------------------------------------------------------------------------
// Contacts & segmentation
// ---------------------------------------------------------------------------

model Contact {
  id           String  @id @default(cuid())
  name         String?
  /// Canonical identity, E.164 ("+919876543210"). Unique — makes duplicates
  /// impossible at the storage layer rather than relying on app logic.
  phoneE164    String  @unique
  phoneCountry String?
  email        String?
  source       String?

  /// Consent is never inferred from a phone number existing.
  optInStatus       OptInStatus @default(UNKNOWN)
  optInAt           DateTime?
  optInSource       String?
  marketingOptOut   Boolean     @default(false)
  marketingOptOutAt DateTime?

  /// Set from real Meta send results, never guessed.
  whatsappStatus  WhatsAppStatus @default(UNKNOWN)
  lastContactedAt DateTime?
  lastInboundAt   DateTime?
  /// Extra CSV columns, usable as template variables.
  attributes      Json?
  notes           String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tags               ContactTag[]
  campaignRecipients CampaignRecipient[]
  messages           Message[]
  conversation       Conversation?
  optOuts            OptOut[]
  automationRuns     AutomationRun[]

  @@index([phoneE164])
  @@index([createdAt])
  @@index([lastContactedAt])
  @@index([optInStatus, marketingOptOut])
  @@index([deletedAt])
  @@index([name])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  color     String?
  createdAt DateTime @default(now())

  contacts          ContactTag[]
  automationActions AutomationAction[]

  @@index([slug])
}

model ContactTag {
  contactId String
  tagId     String
  addedAt   DateTime @default(now())
  addedById String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
// Templates
// ---------------------------------------------------------------------------

model Template {
  id             String           @id @default(cuid())
  /// Null while DRAFT locally, set once Meta accepts the template.
  metaTemplateId String?          @unique
  name           String
  language       String
  category       TemplateCategory
  status         TemplateStatus   @default(DRAFT)
  /// Meta's component array stored verbatim, so a Meta schema addition
  /// does not silently lose data.
  components     Json
  variableCount  Int              @default(0)
  variableNames  Json?
  qualityScore   String?
  rejectedReason String?
  lastSyncedAt   DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  campaigns         Campaign[]
  messages          Message[]
  automationActions AutomationAction[]

  @@unique([name, language])
  @@index([status])
  @@index([category])
  @@index([metaTemplateId])
}

// ---------------------------------------------------------------------------
// Campaigns
// ---------------------------------------------------------------------------

model Campaign {
  id             String         @id @default(cuid())
  name           String
  status         CampaignStatus @default(DRAFT)
  /// Resolves a double-submitted wizard to the same campaign row.
  idempotencyKey String         @unique

  templateId       String?
  /// Snapshot — the template may be renamed or disabled later.
  templateName     String
  templateLanguage String
  templateCategory TemplateCategory

  audienceType    AudienceType
  audienceFilter  Json
  variableMapping Json

  /// Image, video or document for a template whose header is media.
  /// Stored as a public URL rather than an uploaded media id: Meta expires
  /// uploaded media after about a week, which would silently break a repeat
  /// of the same campaign.
  headerMediaUrl  String?
  headerMediaType String?

  scheduledAt DateTime?
  timezone    String    @default("Asia/Kolkata")
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  totalRecipients Int @default(0)
  sentCount       Int @default(0)
  deliveredCount  Int @default(0)
  readCount       Int @default(0)
  failedCount     Int @default(0)
  skippedCount    Int @default(0)
  repliedCount    Int @default(0)

  estimatedCost Decimal? @db.Decimal(12, 4)
  actualCost    Decimal? @db.Decimal(12, 4)
  currency      String?

  /// Set when this campaign resends to the people another campaign failed to
  /// reach. Kept as its own campaign rather than reopening the original, so
  /// each attempt keeps its own counts, cost and audit trail.
  retryOfCampaignId String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template   Template?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy  User                @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  recipients CampaignRecipient[]
  retryOf    Campaign?           @relation("CampaignRetries", fields: [retryOfCampaignId], references: [id], onDelete: SetNull)
  retries    Campaign[]          @relation("CampaignRetries")

  @@index([status])
  @@index([createdAt])
  @@index([scheduledAt])
  @@index([status, scheduledAt])
  @@index([createdById])
  @@index([retryOfCampaignId])
}

model CampaignRecipient {
  id         String  @id @default(cuid())
  campaignId String
  /// Null for recipients that came from a CSV upload with no matching contact.
  contactId  String?
  phoneE164  String
  name       String?
  /// Resolved values frozen at expansion time: what the operator previewed
  /// is what gets sent, even if the contact changes afterwards.
  variables  Json

  status              RecipientStatus @default(PENDING)
  skipReason          String?
  attemptCount        Int             @default(0)
  /// Set once, the first time this person replies after receiving the
  /// campaign. Without it, every subsequent inbound message would inflate the
  /// campaign's reply count.
  repliedAt           DateTime?
  /// Set when a send timed out after the request was written and we cannot
  /// know whether Meta accepted it. Never auto-retried.
  needsReconciliation Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  message  Message?

  @@unique([campaignId, phoneE164])
  @@index([campaignId, status])
  @@index([status])
  @@index([phoneE164])
  @@index([needsReconciliation])
}

// ---------------------------------------------------------------------------
// Conversations & messages
// ---------------------------------------------------------------------------

model Conversation {
  id                     String             @id @default(cuid())
  contactId              String             @unique
  status                 ConversationStatus @default(OPEN)
  lastMessageAt          DateTime?
  lastInboundAt          DateTime?
  lastOutboundAt         DateTime?
  unreadCount            Int                @default(0)
  assignedToId           String?
  /// lastInboundAt + 24h. Drives whether free-form replies are permitted.
  serviceWindowExpiresAt DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedTo User?     @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   Message[]

  @@index([status, lastMessageAt])
  @@index([lastMessageAt])
  @@index([assignedToId])
  @@index([unreadCount])
}

/// Campaign messages and inbox messages are the same object: same wamid, same
/// delivery lifecycle, and a reply to a campaign must appear in the inbox
/// thread. Splitting them would force a duplicate write on every webhook.
model Message {
  id                  String           @id @default(cuid())
  /// Meta's external message ID — the join key for every status webhook.
  wamid               String?          @unique
  direction           MessageDirection
  contactId           String
  conversationId      String?
  campaignRecipientId String?          @unique
  templateId          String?
  sentById            String?

  type    String
  /// Rendered text, for inbox display and search.
  body    String?
  payload Json

  status           MessageStatus @default(QUEUED)
  errorCode        String?
  errorTitle       String?
  errorDetail      String?
  /// Plain-English explanation shown to non-technical users.
  errorUserMessage String?

  pricingCategory String?
  billable        Boolean?
  estimatedCost   Decimal? @db.Decimal(12, 6)

  queuedAt    DateTime  @default(now())
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contact           Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation      Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  campaignRecipient CampaignRecipient? @relation(fields: [campaignRecipientId], references: [id], onDelete: SetNull)
  template          Template?          @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sentBy            User?              @relation("MessageSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([wamid])
  @@index([contactId, createdAt])
  @@index([conversationId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@index([direction, createdAt])
}

// ---------------------------------------------------------------------------
// Webhooks
// ---------------------------------------------------------------------------

model WebhookEvent {
  id        String @id @default(cuid())
  /// sha256(wamid + eventType + timestamp). Unique, so a replayed Meta
  /// webhook is stored once and processed once.
  dedupeKey String @unique

  eventType      String
  wamid          String?
  payload        Json
  signatureValid Boolean
  status         WebhookStatus @default(RECEIVED)
  error          String?
  attemptCount   Int           @default(0)
  receivedAt     DateTime      @default(now())
  processedAt    DateTime?

  @@index([status, receivedAt])
  @@index([wamid])
  @@index([receivedAt])
  @@index([eventType])
}

// ---------------------------------------------------------------------------
// Compliance
// ---------------------------------------------------------------------------

/// Append-only audit trail. Contact.marketingOptOut is the denormalised flag
/// the send query reads; both are written in one transaction. The trail is
/// what you produce if consent is ever challenged — a boolean proves nothing.
model OptOut {
  id              String      @id @default(cuid())
  contactId       String?
  /// Recorded even when no contact exists for the number.
  phoneE164       String
  scope           OptOutScope @default(MARKETING)
  reason          String?
  keyword         String?
  sourceMessageId String?
  createdAt       DateTime    @default(now())

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([phoneE164])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Automations (Phase 3 — defined now to avoid a later migration)
// ---------------------------------------------------------------------------

model Automation {
  id          String    @id @default(cuid())
  name        String
  description String?
  /// Created disabled, deliberately — turning it on messages real customers.
  isActive    Boolean   @default(false)
  runCount    Int       @default(0)
  lastRunAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  triggers  AutomationTrigger[]
  actions   AutomationAction[]
  runs      AutomationRun[]

  @@index([isActive])
}

model AutomationTrigger {
  id           String                @id @default(cuid())
  automationId String
  type         AutomationTriggerType
  config       Json
  createdAt    DateTime              @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([type])
}

model AutomationAction {
  id           String               @id @default(cuid())
  automationId String
  type         AutomationActionType
  order        Int                  @default(0)
  templateId   String?
  tagId        String?
  config       Json
  createdAt    DateTime             @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  template   Template?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  tag        Tag?       @relation(fields: [tagId], references: [id], onDelete: SetNull)

  @@index([automationId, order])
}

model AutomationRun {
  id           String   @id @default(cuid())
  automationId String
  contactId    String?
  /// Idempotency: one inbound message fires a given automation exactly once.
  triggerKey   String
  status       String
  error        String?
  createdAt    DateTime @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contact    Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([automationId, triggerKey])
  @@index([automationId, createdAt])
}

// ---------------------------------------------------------------------------
// Operations, settings & cost
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  /// Denormalised so the record survives user deletion.
  actorEmail  String?
  action      String
  entityType  String?
  entityId    String?
  /// Before/after values, secrets already redacted.
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Non-secret settings live in `value`; secrets are AES-256-GCM encrypted into
/// `valueEnc` and never returned to the browser in plaintext.
model AppSetting {
  key         String   @id
  value       String?
  valueEnc    Bytes?
  isSecret    Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Pricing is data, never code. Versioned by effectiveFrom so a Meta price
/// change does not retroactively rewrite the cost of past campaigns.
model PricingRate {
  id             String           @id @default(cuid())
  /// ISO-3166 alpha-2, or "*" for the fallback rate.
  countryCode    String
  category       TemplateCategory
  currency       String           @default("INR")
  ratePerMessage Decimal          @db.Decimal(12, 6)
  /// Volume band floor for utility/authentication discounts; null = flat rate.
  tierMinVolume  Int?
  effectiveFrom  DateTime         @default(now())
  effectiveTo    DateTime?
  note           String?

  @@unique([countryCode, category, tierMinVolume, effectiveFrom])
  @@index([countryCode, category])
}

model ImportJob {
  id           String       @id @default(cuid())
  filename     String
  status       ImportStatus @default(PENDING)
  totalRows    Int          @default(0)
  createdCount Int          @default(0)
  updatedCount Int          @default(0)
  skippedCount Int          @default(0)
  errorCount   Int          @default(0)
  /// Per-row failures: line number + reason. Nothing is dropped silently.
  errorReport  Json?
  createdById  String?
  createdAt    DateTime     @default(now())
  completedAt  DateTime?

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}
